# Optional. Without a key the app runs on the precomputed outputs in data/precomputed.
# With a key, the Live mode page and "Regenerate" buttons call Groq or the Claude API.
# Set it in your shell or in Vercel's project settings. Never commit a real key.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: LLM_PROVIDER=groq|anthropic, GROQ_MODEL_FAST, GROQ_MODEL_STRONG
